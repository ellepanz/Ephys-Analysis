function Results = MINIS_batchProcess(source,processorFcn,varargin)
% General-purpose batch loader for saved MINI-IPSC experiments.
%
% SOURCE:
%   - Population table with DataFile column
%   - path to population .mat file containing Population
%   - string/cell array of saved experiment .mat files
%
% PROCESSORFCN:
%   cellData = processorFcn(cellData,dataFile)
%
% Options:
%   'SaveChanges'      false
%   'BackupBeforeSave' true
%   'StopOnError'      false
%
% GPTS 
p = inputParser;
addParameter(p,'SaveChanges',false,@(x) islogical(x) && isscalar(x));
addParameter(p,'BackupBeforeSave',true,@(x) islogical(x) && isscalar(x));
addParameter(p,'StopOnError',false,@(x) islogical(x) && isscalar(x));
parse(p,varargin{:});

dataFiles = resolveDataFiles(source);
nFiles = numel(dataFiles);

CellID = strings(nFiles,1);
DataFile = strings(nFiles,1);
Status = strings(nFiles,1);
Message = strings(nFiles,1);
ElapsedSec = nan(nFiles,1);

for i = 1:nFiles
    dataFile = char(dataFiles(i));
    DataFile(i) = string(dataFile);
    tStart = tic;

    fprintf('\n========================================\n');
    fprintf('Experiment %d/%d\n%s\n',i,nFiles,dataFile);
    fprintf('========================================\n');

    try
        if ~isfile(dataFile)
            error('Saved data file does not exist.');
        end

        cellData = load(dataFile);

        if isfield(cellData,'Expt') && isfield(cellData.Expt,'marker')
            CellID(i) = string(cellData.Expt.marker);
            fprintf('Cell: %s\n',CellID(i));
        end

        updatedData = processorFcn(cellData,dataFile);

        if ~isempty(updatedData)
            if ~isstruct(updatedData)
                error('processorFcn must return cellData or [].');
            end
            cellData = updatedData;
        end

        if p.Results.SaveChanges
            if p.Results.BackupBeforeSave
                backupFile = [dataFile '.bak'];
                if ~isfile(backupFile)
                    copyfile(dataFile,backupFile);
                end
            end
            save(dataFile,'-struct','cellData','-v7.3');
        end

        Status(i) = "OK";

    catch ME
        Status(i) = "ERROR";
        Message(i) = string(ME.message);
        warning('%s failed: %s',dataFile,ME.message);

        if p.Results.StopOnError
            rethrow(ME);
        end
    end

    ElapsedSec(i) = toc(tStart);
end

Results = table(CellID,DataFile,Status,Message,ElapsedSec);

fprintf('\nBatch complete. Successful: %d | Failed: %d\n', ...
    sum(Status=="OK"),sum(Status=="ERROR"));

end

function dataFiles = resolveDataFiles(source)

if istable(source)
    if ~ismember('DataFile',source.Properties.VariableNames)
        error('Population table does not contain a DataFile column.');
    end
    dataFiles = string(source.DataFile);

elseif ischar(source) || (isstring(source) && isscalar(source))
    sourcePath = char(source);

    if ~isfile(sourcePath)
        error('SOURCE path does not exist: %s',sourcePath);
    end

    tmp = load(sourcePath);

    if isfield(tmp,'Population') && istable(tmp.Population) && ...
            ismember('DataFile',tmp.Population.Properties.VariableNames)
        dataFiles = string(tmp.Population.DataFile);
    else
        dataFiles = string(sourcePath);
    end

elseif isstring(source) || iscellstr(source)
    dataFiles = string(source(:));

else
    error('SOURCE must be a Population table, population MAT file, or list of experiment MAT files.');
end

dataFiles = dataFiles(strlength(dataFiles)>0);
dataFiles = unique(dataFiles,'stable');

end
