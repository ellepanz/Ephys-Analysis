function Data = MINIS_QCTestPulses(Data, S, conditions, figureFolder)
% MINIS_QCTestPulses
%
% Visually inspect test pulses from trials that passed the earlier MINI QC.
%
% Clicking a test-pulse tile cycles through:
%
%   GOOD         -> use for Rs and Rin
%   BAD Rin      -> use for Rs, exclude from Rin
%   BAD Rs/Rin   -> exclude from both Rs and Rin
%
% These flags affect ONLY resistance/stability calculations.
% They do NOT remove trials from the MINI-IPSC analysis.
%
% Results are stored in:
%
%   Data.(cond).RsValid
%   Data.(cond).RinValid
%   Data.(cond).badRsTrialNames
%   Data.(cond).badRinTrialNames
%   Data.(cond).resistanceQCTrialNames
%
% Flags are aligned with:
%
%   Data.(cond).notDelTrialNames


%% Display settings

prePulseSec = 0.5;                      % show 500 ms before test pulse
prePulseSamples = round(prePulseSec*S.Fs);


for c = 1:numel(conditions)
    cond = conditions{c};

    %% Get only trials that passed MINI trac
    trialNames = Data.(cond).notDelTrialNames(:)';
    nTrials = numel(trialNames);
    trialNums = cellfun(@(x) sscanf(x,'AD0_%d'), trialNames);

    %% Check that corresponding raw traces exist
    for k = 1:nTrials

        if ~isfield(Data.rawTraces.(cond), trialNames{k})
            error('Raw trace %s is missing from Data.rawTraces.%s.', ...
                trialNames{k}, cond);
        end

    end


    %% Initialize QC states
    %
    % State 1 = GOOD
    % State 2 = BAD Rin only
    % State 3 = BAD Rs and Rin

    state = ones(1,nTrials);

    % If QC has already been performed, preserve previous selections
    if isfield(Data.(cond),'RsValid') && ...
            isfield(Data.(cond),'RinValid') && ...
            numel(Data.(cond).RsValid) == nTrials

        oldRsValid = Data.(cond).RsValid;
        oldRinValid = Data.(cond).RinValid;

        for k = 1:nTrials

            if ~oldRsValid(k)
                state(k) = 3;

            elseif ~oldRinValid(k)
                state(k) = 2;

            else
                state(k) = 1;
            end

        end
    end


    %% Determine tile arrangement

    nCols = 4;
    nRows = ceil(nTrials/nCols);


    %% Create figure

    fig = figure( ...
        'Name',[strrep(cond,'_','/') ' Test Pulse QC'], ...
        'NumberTitle','off', ...
        'Color','w', ...
        'Position',[100 50 1500 850]);

    tl = tiledlayout(fig,nRows,nCols, ...
        'TileSpacing','compact', ...
        'Padding','compact');

    title(tl,[strrep(cond,'_','/') ' Test Pulses'], ...
        'Interpreter','none');


    lineHandles = gobjects(1,nTrials);
    axHandles = gobjects(1,nTrials);


    %% Plot each test pulse

    for k = 1:nTrials

        rawTrace = Data.rawTraces.(cond).(trialNames{k});

        startIdx = max(1, S.sealStartIdx - prePulseSamples);
        endIdx = min(numel(rawTrace), S.sealEndIdx);

        pulseTrace = rawTrace(startIdx:endIdx);

        % Time relative to test-pulse onset
        sampleIdx = startIdx:endIdx;

        timeMs = ...
            (sampleIdx - S.sealStartIdx) / S.Fs * 1000;


        ax = nexttile(tl);
        hold(ax,'on');

        h = plot(ax,timeMs,pulseTrace, ...
            'LineWidth',0.75);

        % Mark test-pulse onset
        onsetLine = xline(ax,0,'--');
        onsetLine.HitTest = 'off';

        xlabel(ax,'Time from pulse onset (ms)');
        ylabel(ax,'Current (pA)');

        box(ax,'off');


        %% Allow click anywhere on trace/tile

        h.ButtonDownFcn = ...
            @(src,event) cyclePulseState(src,event,k);

        ax.ButtonDownFcn = ...
            @(src,event) cyclePulseState(src,event,k);

        h.PickableParts = 'all';
        h.HitTest = 'on';


        lineHandles(k) = h;
        axHandles(k) = ax;

    end


    %% Store interactive information in figure

    fig.UserData.state = state;
    fig.UserData.lineHandles = lineHandles;
    fig.UserData.axHandles = axHandles;
    fig.UserData.trialNames = trialNames;


    % Apply initial titles/styles
    for k = 1:nTrials
        updatePulseDisplay(fig,k);
    end


    %% Instructions

    annotation(fig,'textbox', ...
        [0.01 0.01 0.75 0.04], ...
        'String', ...
        ['Click a tile to cycle:  GOOD  ->  BAD Rin  ->  ' ...
         'BAD Rs/Rin  ->  GOOD'], ...
        'EdgeColor','none', ...
        'FontSize',11);


    %% Done button

    doneButton = uicontrol(fig, ...
        'Style','pushbutton', ...
        'String','Done', ...
        'Position',[20 45 100 30], ...
        'Callback',@(src,~) uiresume(ancestor(src,'figure')));


    % Clicking X also finishes QC rather than destroying the figure
    fig.CloseRequestFcn = @(src,~) uiresume(src);


    drawnow
    uiwait(fig);


    if ~isgraphics(fig)
        error('Test-pulse QC figure was unexpectedly destroyed.');
    end


    %% Convert states into validity flags

    state = fig.UserData.state;

    % Rs is invalid only for state 3
    RsValid = state ~= 3;

    % Rin is valid only for completely clean pulses
    RinValid = state == 1;


    %% Store QC results

    Data.(cond).resistanceQCTrialNames = trialNames;
    Data.(cond).resistanceQCTrialNums = trialNums;

    Data.(cond).RsValid = RsValid;
    Data.(cond).RinValid = RinValid;

    Data.(cond).badRsTrialNames = trialNames(~RsValid);
    Data.(cond).badRinTrialNames = trialNames(~RinValid);

    Data.(cond).badRsTrialNums = trialNums(~RsValid);
    Data.(cond).badRinTrialNums = trialNums(~RinValid);


    %% Also make a convenient QC table

    Data.(cond).resistanceQC = table( ...
        trialNums(:), ...
        trialNames(:), ...
        RsValid(:), ...
        RinValid(:), ...
        'VariableNames', ...
        {'TrialNum','TrialName','RsValid','RinValid'});


    %% Turn interactive figure into normal figure before saving

    delete(doneButton);

    for k = 1:nTrials

        lineHandles(k).ButtonDownFcn = [];
        axHandles(k).ButtonDownFcn = [];

    end

    fig.CloseRequestFcn = 'closereq';


    %% Save QC figure

    if nargin >= 4 && ~isempty(figureFolder)

        saveas(fig, ...
            fullfile(figureFolder, ...
            [cond ' Test Pulse QC.fig']));

        saveas(fig, ...
            fullfile(figureFolder, ...
            [cond ' Test Pulse QC.png']));

    end


    close(fig);
    drawnow

end

end


%% =========================================================
% CLICK CALLBACK
% ==========================================================

function cyclePulseState(src,~,trialIdx)

fig = ancestor(src,'figure');

state = fig.UserData.state;

% Cycle:
% 1 GOOD -> 2 BAD Rin -> 3 BAD Rs/Rin -> 1 GOOD
state(trialIdx) = mod(state(trialIdx),3) + 1;

fig.UserData.state = state;

updatePulseDisplay(fig,trialIdx);

end


%% =========================================================
% UPDATE TILE APPEARANCE
% ==========================================================

function updatePulseDisplay(fig,trialIdx)

state = fig.UserData.state;

h = fig.UserData.lineHandles(trialIdx);
ax = fig.UserData.axHandles(trialIdx);

trialName = fig.UserData.trialNames{trialIdx};


switch state(trialIdx)

    case 1
        status = 'GOOD';

        h.LineStyle = '-';
        h.LineWidth = 0.75;


    case 2
        status = 'BAD Rin';

        h.LineStyle = '--';
        h.LineWidth = 1.5;


    case 3
        status = 'BAD Rs/Rin';

        h.LineStyle = ':';
        h.LineWidth = 2;

end


title(ax, ...
    sprintf('%s | %s',trialName,status), ...
    'Interpreter','none');

end