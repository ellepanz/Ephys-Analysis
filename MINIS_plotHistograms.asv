function MINIS_plotHistograms(Data, color, conditions)

%% Create figure
figure('Color','w', ...
    'Position',[200 200 1100 450]);

tiledlayout(2,2, ...
    'TileSpacing','compact', ...
    'Padding','compact');

%% Plot histogram for each condition
for c = [1 3]

    cond = conditions{c};
    nexttile;

    % Pull concatenated stable data
    currentData = Data.(cond).stableConcatData;
    histogram(currentData, 'BinWidth', 5, FaceColor', color{c});

    xlabel('Current (pA)');
    ylabel('Frequency');
    title(strrep(cond,'_','/'), 'Interpreter','none');
    
    
     
end

sgtitle('All-Point Current Histograms');

end